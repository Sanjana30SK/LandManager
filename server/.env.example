# Copy this file to ".env" and fill in your own values.
# The real .env file is git-ignored because it contains your database password.

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers).
# Replace <username> and <password> with your Atlas database user.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority

# Name of the database inside the cluster. Created automatically on first write.
MONGODB_DB_NAME=land_parcel_manager

# Port the API server listens on.
PORT=5000

# Address of the frontend that is allowed to call the API (CORS). Vite's default:
CLIENT_ORIGIN=http://localhost:5173
